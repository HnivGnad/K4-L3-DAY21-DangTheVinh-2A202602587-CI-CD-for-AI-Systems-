{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadLabBucketMetadata",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketLocation"],
      "Resource": "arn:aws:s3:::income-lab-vinh-2a202602587-20261007-01"
    },
    {
      "Sid": "ManageLabDataAndModels",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": [
        "arn:aws:s3:::income-lab-vinh-2a202602587-20261007-01/dvc/*",
        "arn:aws:s3:::income-lab-vinh-2a202602587-20261007-01/artifacts/*"
      ]
    }
  ]
}
